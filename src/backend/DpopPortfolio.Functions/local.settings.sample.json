{
  "IsEncrypted": false,
  "Values": {
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",
    "FUNCTIONS_WORKER_RUNTIME": "dotnet-isolated",
    "DpopPortfolio__Issuer": "http://localhost:7071",
    "DpopPortfolio__Audience": "dpop-portfolio-api",
    "DpopPortfolio__FrontendOrigin": "http://localhost:3000",
    "DpopPortfolio__CacheProvider": "Memory",
    "DpopPortfolio__StorageProvider": "Azurite",
    "DpopPortfolio__TokenLifetimes__AuthorizationCodeMinutes": "5",
    "DpopPortfolio__TokenLifetimes__AccessTokenMinutes": "15",
    "DpopPortfolio__TokenLifetimes__RefreshTokenDays": "7",
    "DpopPortfolio__TokenLifetimes__DpopProofSeconds": "300"
  }
}
